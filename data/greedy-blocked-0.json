{"filename":"최상우선탐색.py","algorithm":"greedy","label":"최상우선탐색","source":"NO_COST_MODE = False\nMAP_FILE = \"map4.txt\"\nCOST_FILE = \"cost4.txt\"\n\n이동방향 = {(-1, 0): \"↓\", (0, 1): \"←\", (1, 0): \"↑\", (0, -1): \"→\"}\n역추적방향 = {화살표: (-행변화, -열변화) for (행변화, 열변화), 화살표 in 이동방향.items()}\n\n\ndef 벽과공간획득(파일이름):\n    \"\"\"텍스트의 각 글자를 한 칸으로 만든다.\"\"\"\n    with open(파일이름, encoding=\"utf-8\") as 파일:\n        return [list(줄.strip()) for 줄 in 파일]\n\n\ndef 비용획득(파일이름, 비용무시=False):\n    \"\"\"자연수(1이상 9이하) 비용 격자를 읽는다. 비용무시=True이면 모든 비용을 1로 만든다.\"\"\"\n    with open(파일이름, encoding=\"utf-8\") as 파일:\n        if 비용무시:\n            return [[1] * len(줄.strip()) for 줄 in 파일]\n        return [[int(글자) for 글자 in 줄.strip()] for 줄 in 파일]\n\n\ndef 정보통합(벽과공간, 비용정보):\n    \"\"\"새 지도를 만들고 출발점과 도착점의 좌표를 반환한다.\"\"\"\n    지도 = []\n    출발점 = 도착점 = (-1, -1)\n\n    for 행번호, 한줄벽과공간 in enumerate(벽과공간):\n        지도행 = []\n        for 열번호, 각칸의정보 in enumerate(한줄벽과공간):\n            지도행.append({\n                \"벽\": 각칸의정보,\n                \"노드진입비용\": int(비용정보[행번호][열번호]),\n                \"g\": float(\"inf\"),\n                \"직전\": \"\",\n            })\n            if 각칸의정보 == \"s\":\n                출발점 = (행번호, 열번호)\n            elif 각칸의정보 == \"d\":\n                도착점 = (행번호, 열번호)\n        지도.append(지도행)\n\n    if 출발점 == (-1, -1) or 도착점 == (-1, -1):\n        raise ValueError(\"지도에는 출발점 s와 도착점 d가 필요합니다.\")\n    return 지도, 출발점, 도착점\n\n\ndef 탐색(지도, 출발점, 도착점):\n    \"\"\"지도에서 각 칸의 g값 및 직전 위치를 갱신한다.\"\"\"\n    행개수, 열개수 = len(지도), len(지도[0])\n    목표행, 목표열 = 도착점\n    후보 = []\n    탐색순서 = []\n\n    def h(위치):\n        행, 열 = 위치\n        return ((행 - 목표행) ** 2 + (열 - 목표열) ** 2) ** 0.5\n\n    def 넣기또는갱신(위치):\n        노드정보 = (위치, h(위치))\n        일치노드찾음 = False\n        for 순번, (후보위치, _) in enumerate(후보):\n            if 후보위치 == 위치:\n                후보[순번] = 노드정보\n                일치노드찾음 = True\n                break\n        if not 일치노드찾음:\n            후보.append(노드정보)\n\n        후보.sort(key=lambda 항목: 항목[1])\n\n    시작행, 시작열 = 출발점\n    지도[시작행][시작열][\"g\"] = 지도[시작행][시작열][\"노드진입비용\"]\n    지도[시작행][시작열][\"직전\"] = \"0\"\n    넣기또는갱신(출발점)\n\n    while 후보:\n        현재위치, _ = 후보.pop(0)\n        행, 열 = 현재위치\n        현재칸 = 지도[행][열]\n        탐색순서.append(현재위치)\n\n        if 현재위치 == 도착점:\n            break\n\n        for (행변화, 열변화), 화살표 in 이동방향.items():\n            다음행, 다음열 = 행 + 행변화, 열 + 열변화\n            if not (0 <= 다음행 < 행개수 and 0 <= 다음열 < 열개수):\n                continue\n\n            이웃칸 = 지도[다음행][다음열]\n            if 이웃칸[\"벽\"] == \"1\":\n                continue\n\n            새비용 = 현재칸[\"g\"] + 이웃칸[\"노드진입비용\"]\n            if 새비용 >= 이웃칸[\"g\"]:\n                continue\n\n            지도[다음행][다음열][\"g\"] = 새비용\n            지도[다음행][다음열][\"직전\"] = 화살표\n            넣기또는갱신((다음행, 다음열))\n\n    return 지도, 탐색순서\n\n\ndef 경로복원(지도, 출발점, 도착점):\n    \"\"\"직전 화살표를 따라 최종 경로를 복원한다. 경로가 없으면 빈 리스트를 반환한다.\"\"\"\n    행, 열 = 도착점\n    if not 지도[행][열][\"직전\"]:\n        return []\n\n    경로 = [도착점]\n    while (행, 열) != 출발점:\n        행변화, 열변화 = 역추적방향[지도[행][열][\"직전\"]]\n        행, 열 = 행 + 행변화, 열 + 열변화\n        경로.append((행, 열))\n    return 경로[::-1]\n\n\ndef 결과표시(완성지도, 탐색순서, 출발점, 도착점):\n    \"\"\"지도 / 중복 처리를 포함한 탐색 순서 / 최종 경로를 출력한다.\"\"\"\n    print(\"최상우선탐색\")\n    for 행번호, 지도행 in enumerate(완성지도):\n        표시행 = []\n\n        for 열번호, 칸 in enumerate(지도행):\n            if (행번호, 열번호) == 출발점:\n                표시행.append(\"s\")\n            elif 칸[\"직전\"] != \"\":\n                표시행.append(칸[\"직전\"])\n            else:\n                표시행.append(칸[\"벽\"])\n        print(\" \".join(표시행))\n    print()\n\n    print(f\"탐색 순서({len(탐색순서)}회):\", 탐색순서)\n    경로 = 경로복원(완성지도, 출발점, 도착점)\n    if not 경로:\n        print(\"탐색 실패(경로 없음)\")\n        return\n\n    목표행, 목표열 = 도착점\n    총비용 = 완성지도[목표행][목표열][\"g\"]\n    print(f\"최종 경로({len(경로)}칸 총 비용 {총비용}): {경로}\")\n\n\ndef main():\n    벽과공간 = 벽과공간획득(MAP_FILE)\n    비용정보 = 비용획득(COST_FILE, 비용무시=NO_COST_MODE)\n    지도, 출발점, 도착점 = 정보통합(벽과공간, 비용정보)\n    완성지도, 탐색순서 = 탐색(지도, 출발점, 도착점)\n    결과표시(완성지도, 탐색순서, 출발점, 도착점)\n\n\nif __name__ == \"__main__\":\n    main()\n","sha256":"d45c82d60c7dc371a726f0184721078b655d824cc1ecba3c8144bb90134c403b","example":{"name":"도착할 수 없는 지도","map":["s10","111","01d"],"cost":["111","111","111"]},"noCost":false,"events":[{"line":148,"fn":"main","stack":["main"],"vars":{},"state":0},{"line":11,"fn":"벽과공간획득","stack":["main","벽과공간획득"],"vars":{},"state":0},{"line":12,"fn":"벽과공간획득","stack":["main","벽과공간획득"],"vars":{},"state":0},{"line":12,"fn":"벽과공간획득","stack":["main","벽과공간획득"],"vars":{},"state":0},{"line":12,"fn":"벽과공간획득","stack":["main","벽과공간획득"],"vars":{},"state":0},{"line":12,"fn":"벽과공간획득","stack":["main","벽과공간획득"],"vars":{},"state":0},{"line":11,"fn":"벽과공간획득","stack":["main","벽과공간획득"],"vars":{},"state":0},{"line":149,"fn":"main","stack":["main"],"vars":{},"state":0},{"line":17,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":18,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":{"비용무시":false},"state":0},{"line":20,"fn":"비용획득","stack":["main","비용획득"],"vars":